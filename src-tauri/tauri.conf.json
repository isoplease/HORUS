{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "HORUS",
  "version": "0.2.19",
  "identifier": "com.isoplease.horus",
  "build": {
    "beforeDevCommand": "pnpm run dev",
    "beforeBuildCommand": "pnpm run build",
    "devUrl": "http://localhost:1420",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "HORUS Command Deck",
        "width": 1260,
        "height": 840,
        "minWidth": 760,
        "minHeight": 560,
        "resizable": true,
        "visible": false,
        "skipTaskbar": true,
        "transparent": true,
        "decorations": true,
        "fullscreen": false
      }
    ],
    "security": {
      "capabilities": ["default"],
      "csp": {
        "default-src": "'self' customprotocol: asset:",
        "connect-src": "'self' ipc: http://ipc.localhost",
        "img-src": "'self' asset: http://asset.localhost data:",
        "object-src": "'none'",
        "script-src": "'self'",
        "style-src": "'self' 'unsafe-inline'",
        "base-uri": "'self'",
        "frame-ancestors": "'none'"
      }
    }
  },
  "bundle": {
    "active": true,
    "createUpdaterArtifacts": true,
    "targets": ["nsis"],
    "publisher": "isoplease",
    "shortDescription": "Real-time Windows system observatory",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "displayLanguageSelector": false,
        "installerHooks": "./windows/hooks.nsh",
        "installerIcon": "icons/icon.ico",
        "uninstallerIcon": "icons/icon.ico"
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDQ1OTcyNzhCNTc4MzZCNApSV1MwTm5pMWVISlpCSjZDTzI4YnZWb1h2TnhQcWVWai8xUEtYL0V3MEhob0NrdEJEUFh5UXIxZgo=",
      "endpoints": [
        "https://github.com/isoplease/HORUS/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
